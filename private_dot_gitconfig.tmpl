[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[user]
	name = Kyri Sarantakos
	email = ksarantakos@gmail.com
	signingkey = {{ .chezmoi.homeDir }}/.ssh/id_ed25519.pub
[commit]
	gpgsign = true
[gpg]
	format = ssh

# Delta - better git diff
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = base16
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
