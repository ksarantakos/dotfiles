{{- /* Ignore templates that require 1Password when op is unavailable or unresponsive. */ -}}
{{- $opAvailable := eq (trim (output "sh" (print .chezmoi.sourceDir "/.chezmoitemplates/op-available.sh"))) "yes" -}}
{{- if not $opAvailable -}}
.npmrc
{{- end }}

{{- /* Never manage generated AWS auth material. */ -}}
.aws/credentials
.aws/cli
.aws/sso
.aws/login

{{- /* Ignore macOS-only paths on Linux */ -}}
{{- if ne .chezmoi.os "darwin" }}
.config/iterm2
{{- end }}

{{- /* Ignore Windows-only paths on non-Windows */ -}}
{{- if ne .chezmoi.os "windows" }}
Documents/WindowsPowerShell
Documents/PowerShell
{{- end -}}
